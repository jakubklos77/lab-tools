#!/usr/bin/env bash

input="$*"
result=$(echo "$input" | "$HOME/app/fabric/fabric" -sp terminal_assistant)

if [[ $? -eq 0 && -n "$result" ]]; then
  echo "$result"

  command=$(echo "$result" | awk '/^```bash$/{found=1; next} found && /^```/{exit} found{print}' | sed '/^[[:space:]]*$/d')

  if [[ -z "$command" ]]; then
    command=$(echo "$result" | grep -v '^$' | tail -n 1)
  fi

  if [[ -n "$command" ]]; then
    if [ -n "$SSH_CONNECTION" ]; then
      printf "\033]52;c;%s\a" "$(echo -n "$command" | base64 -w 0)"
    else
      echo -n "$command" | wl-copy
    fi
  fi
fi